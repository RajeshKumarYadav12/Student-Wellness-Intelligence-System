{
  "version": 2,
  "name": "aura-dashboard",
  "buildCommand": "export bakend_api=https://student-wellness-intelligence-system.onrender.com && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "framework": null,
  "installCommand": "cd frontend && npm install",
  "devCommand": "cd frontend && npm start",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "bakend_api": "@bakend_api"
  },
  "build": {
    "env": {
      "bakend_api": "@bakend_api"
    }
  }
}
